{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "my-kakeibo",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-19",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*"
        ]
    }
}